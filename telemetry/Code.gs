// The Sheet remains private. The admin_read route below PUBLICLY exposes player names and gameplay records.
// Set PUBLIC_ADMIN_READ=false to disable public reading. PIN-derived hashes are never returned.
var PUBLIC_ADMIN_READ=true;
var EVENT_HEADERS=['timestamp','player_id','profile_id','run_id','event_id','type','version','day','time','location','action','result','health','hunger','thirst','stress','ap','quest','story','chapter','water','food','battery','phone','bag','mode','wound','active_seconds','device','width','height','details'];
var RUN_HEADERS=['run_id','player_id','profile_id','started_at','last_seen','version','status','day','location','active_seconds','quest','story','chapter','actions','failures','panics','mistakes','death_reason'];
var PLAYER_HEADERS=['profile_id','player_id','first_seen','last_seen','runs'];
function json_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function sheet_(){var id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('setup_required');return SpreadsheetApp.openById(id);}
function ensureTab_(book,name,headers){var sh=book.getSheetByName(name)||book.insertSheet(name);if(!sh.getLastRow()){sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#253b30').setFontColor('#eee4c8');}return sh;}
function setup(){var active=SpreadsheetApp.getActiveSpreadsheet();if(!active)throw Error('Open this script from the destination Sheet first.');PropertiesService.getScriptProperties().setProperty('SHEET_ID',active.getId());ensureTab_(active,'events',EVENT_HEADERS);ensureTab_(active,'runs',RUN_HEADERS);ensureTab_(active,'players',PLAYER_HEADERS);var dashboard=ensureTab_(active,'dashboard',['지표','값']);dashboard.getRange(2,1,8,2).setValues([['플레이어 수','=COUNTA(players!A2:A)'],['전체 회차','=COUNTA(runs!A2:A)'],['사망 회차','=COUNTIF(runs!G2:G,"dead")'],['가족 집 목표 도달','=COUNTIF(runs!K2:K,">=3")'],['총 패닉','=SUM(runs!P2:P)'],['총 실수','=SUM(runs!Q2:Q)'],['실패한 행동','=SUM(runs!O2:O)'],['기록 수','=COUNTA(events!E2:E)']]);dashboard.autoResizeColumns(1,2);return 'Ready. Deploy as a web app, then put its /exec URL in v2/telemetry-config.js.';}
function doGet(){return json_({ok:true,service:'12:00 tester event receiver',schema:1});}
function cleanText_(value,max){return String(value===undefined?'':value).replace(/[\u0000-\u001f\u007f]/g,' ').slice(0,max);}
function cell_(value){if(typeof value!=='string')return value;if(/^[=+\-@]/.test(value))return "'"+value;return value;}
function validateEvent_(input){if(!input||typeof input!=='object'||Array.isArray(input))throw Error('invalid_event');var allowed=EVENT_HEADERS.concat(['schema']);Object.keys(input).forEach(function(k){if(allowed.indexOf(k)<0)throw Error('unexpected_field');});if(input.schema!==1||!/^([a-f0-9]{64})$/.test(input.profile_id||''))throw Error('invalid_profile');if(!/^[a-f0-9-]{36}$/.test(input.run_id||'')||!/^([a-f0-9-]{36}):[1-9][0-9]{0,8}$/.test(input.event_id||'')||input.event_id.indexOf(input.run_id+':')!==0)throw Error('invalid_id');var types=['run_start','run_resume','heartbeat','action','location','day_change','objective','panic','mistake','panic_recovery','death'];if(types.indexOf(input.type)<0)throw Error('invalid_type');var e={schema:1},text={timestamp:30,player_id:14,profile_id:64,run_id:36,event_id:48,type:30,version:20,location:80,action:71,result:40,mode:20,wound:50,device:20};Object.keys(text).forEach(function(k){e[k]=cleanText_(input[k],text[k]);});if(!e.player_id.trim()||isNaN(Date.parse(e.timestamp)))throw Error('invalid_player_or_time');var names=PropertiesService.getScriptProperties().getProperty('TESTER_NAMES');if(names&&names.split(',').map(function(x){return x.trim();}).indexOf(e.player_id)<0)throw Error('tester_not_allowed');['day','time','health','hunger','thirst','stress','ap','quest','story','chapter','water','food','battery','phone','bag','active_seconds','width','height'].forEach(function(k){var n=input[k];if(typeof n!=='number'||!isFinite(n)||n<0||n>10000000)throw Error('invalid_number');e[k]=n;});if(input.details!==undefined&&(!input.details||typeof input.details!=='object'||Array.isArray(input.details)||Object.keys(input.details).some(function(k){return k!=='previous_day';})))throw Error('invalid_details');e.details=input.details||{};return e;}
function doPost(request){try{var raw=request&&request.postData&&request.postData.contents||'';if(raw.length>50000)throw Error('batch_too_large');var body=JSON.parse(raw);if(body.action==='admin_read'){if(body.schema!==1||Object.keys(body).some(function(k){return k!=='action'&&k!=='schema';}))throw Error('invalid_read_request');return publicAdminRead_();}if(body.schema!==1||!Array.isArray(body.events)||body.events.length<1||body.events.length>20)throw Error('invalid_batch');var events=body.events.map(validateEvent_),lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('busy');try{var book=sheet_(),log=ensureTab_(book,'events',EVENT_HEADERS),last=log.getLastRow(),seen=new Set(last>1?log.getRange(2,5,last-1,1).getValues().map(function(row){return row[0];}):[]),fresh=[];events.forEach(function(e){if(!seen.has(e.event_id)){fresh.push(e);seen.add(e.event_id);}});if(fresh.length){log.getRange(last+1,1,fresh.length,EVENT_HEADERS.length).setValues(fresh.map(function(e){return EVENT_HEADERS.map(function(k){return cell_(k==='details'?JSON.stringify(e.details):e[k]);});}));}rebuildSummaries_(book,log);return json_({ok:true,accepted:events.map(function(e){return e.event_id;})});}finally{lock.releaseLock();}}catch(error){return json_({ok:false,error:String(error.message||'receiver_error').slice(0,80)});}}
// Rebuild from the authoritative log: duplicate retries and a failed summary update never double count.
function rebuildSummaries_(book,log){var rows=log.getLastRow()>1?log.getRange(2,1,log.getLastRow()-1,EVENT_HEADERS.length).getValues():[],runs={},players={};rows.forEach(function(row){var e={};EVENT_HEADERS.forEach(function(k,i){e[k]=row[i];});var r=runs[e.run_id];if(!r)r=runs[e.run_id]={run_id:e.run_id,player_id:e.player_id,profile_id:e.profile_id,started_at:e.timestamp,last_seen:e.timestamp,version:e.version,status:'playing',actions:0,failures:0,panics:0,mistakes:0,death_reason:''};r.last_seen=e.timestamp;r.version=e.version;['day','location','active_seconds','quest','story','chapter'].forEach(function(k){r[k]=e[k];});if(e.type==='action'){r.actions++;if(e.result!=='changed'&&e.result!=='ok')r.failures++;}if(e.type==='panic')r.panics++;if(e.type==='mistake')r.mistakes++;if(e.type==='death'){r.status='dead';r.death_reason=e.result;}var p=players[e.profile_id];if(!p)p=players[e.profile_id]={profile_id:e.profile_id,player_id:e.player_id,first_seen:e.timestamp,last_seen:e.timestamp,runs:{}};p.last_seen=e.timestamp;p.runs[e.run_id]=true;});var runTab=ensureTab_(book,'runs',RUN_HEADERS),playerTab=ensureTab_(book,'players',PLAYER_HEADERS);if(runTab.getLastRow()>1)runTab.getRange(2,1,runTab.getLastRow()-1,RUN_HEADERS.length).clearContent();if(playerTab.getLastRow()>1)playerTab.getRange(2,1,playerTab.getLastRow()-1,PLAYER_HEADERS.length).clearContent();var rvalues=Object.keys(runs).map(function(id){return RUN_HEADERS.map(function(k){return cell_(runs[id][k]===undefined?'':runs[id][k]);});}),pvalues=Object.keys(players).map(function(id){return PLAYER_HEADERS.map(function(k){return cell_(k==='runs'?Object.keys(players[id].runs).length:players[id][k]);});});if(rvalues.length)runTab.getRange(2,1,rvalues.length,RUN_HEADERS.length).setValues(rvalues);if(pvalues.length)playerTab.getRange(2,1,pvalues.length,PLAYER_HEADERS.length).setValues(pvalues);}

// Read a consistent snapshot of the append-only event log, without changing the Sheet.
// Public aliases preserve grouping but do not expose the PIN-derived profile hash.
function publicAdminRead_(){
  if(!PUBLIC_ADMIN_READ)return json_({ok:false,error:'public_read_disabled'});
  var lock=LockService.getScriptLock();
  if(!lock.tryLock(10000))return json_({ok:false,error:'busy'});
  try{
    var book=sheet_(),log=book.getSheetByName('events');
    if(!log)throw Error('events_missing');
    var count=Math.max(0,log.getLastRow()-1);
    if(count>50000)throw Error('read_limit_exceeded');
    var header=log.getRange(1,1,1,EVENT_HEADERS.length).getValues()[0];
    if(EVENT_HEADERS.some(function(k,i){return header[i]!==k;}))throw Error('header_mismatch');
    var rows=count?log.getRange(2,1,count,EVENT_HEADERS.length).getValues():[];
    var aliases=new Map(),events=[];
    rows.forEach(function(row){
      var e={};EVENT_HEADERS.forEach(function(k,i){
        if(['profile_id','width','height','details'].indexOf(k)<0)e[k]=row[i];
      });
      var profile=String(row[2]);
      if(!aliases.has(profile))aliases.set(profile,'player_'+String(aliases.size+1).padStart(6,'0'));
      e.profile_id=aliases.get(profile);events.push(e);
    });
    return json_({ok:true,schema:1,visibility:'public',count:events.length,updated_at:new Date().toISOString(),events:events});
  }catch(error){return json_({ok:false,error:String(error.message||'read_error').slice(0,80)});}
  finally{lock.releaseLock();}
}
